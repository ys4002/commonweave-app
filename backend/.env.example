# Docker Compose PostgreSQL connection
DB_URL=jdbc:postgresql://postgres:5432/commonweave
DB_USERNAME=commonweave
DB_PASSWORD=change-me

# Select the PostgreSQL Flyway scripts for the Docker database.
FLYWAY_LOCATIONS=classpath:db/migration/postgresql

# Local container defaults. For production, use SPRING_PROFILES_ACTIVE=prod,
# APP_COOKIE_SECURE=true, APP_COOKIE_SAME_SITE=None, and the public frontend origin.
SPRING_PROFILES_ACTIVE=dev
APP_CORS_ORIGINS=http://localhost:5173
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax
